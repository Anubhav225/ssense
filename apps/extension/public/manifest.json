{
  "manifest_version": 3,
  "name": "Ssense \u2014 DPDP Privacy Shield",
  "short_name": "Ssense",
  "version": "1.0.0",
  "version_name": "1.0.0 (General Release)",
  "description": "Instant DPDP Act 2023 compliance auditing for every site you visit. Sign in once with Google, and your audit history stays in sync across your devices.",
  "author": "Ssense Engineering",
  "homepage_url": "https://ssense.app",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "notifications",
    "identity",
    "identity.email",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/api-spoof.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/extractor.js",
        "content/dark-pattern-blocker.js",
        "content/chat-widget.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Open Ssense Privacy Shield",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "oauth2": {
    "client_id": "__GOOGLE_CLIENT_ID__",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  }
}
