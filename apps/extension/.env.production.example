# ═══════════════════════════════════════════════════════════════════════════
# apps/extension/.env.production
# Copy to `.env.production` before running `npm run build`.
# Vite inlines every VITE_-prefixed value into the shipped bundle, so nothing
# here may be secret. (Shared API keys are no longer baked in: each user gets
# their own credentials when they sign in with Google.)
# ═══════════════════════════════════════════════════════════════════════════

# Public HTTPS URL of your Ssense SLM server.
VITE_SSENSE_SERVER_URL=https://api.example.com

# REQUIRED. OAuth client of type "Chrome extension" (Google Cloud Console →
# APIs & Services → Credentials). Its "Application ID" is your extension's
# Chrome Web Store id. The SAME id must be listed in the server's
# SSENSE_GOOGLE_CLIENT_IDS.
VITE_GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com

# OPTIONAL. OAuth client of type "Web application" whose authorised redirect URI is
# https://<extension-id>.chromiumapp.org/ . Enables sign-in on Chromium browsers that
# don't support chrome.identity.getAuthToken (Edge, Brave, Opera, Kiwi…).
# Add it to SSENSE_GOOGLE_CLIENT_IDS on the server too.
VITE_GOOGLE_WEB_CLIENT_ID=

# OPTIONAL, development only. Public key from your Web Store item (Package →
# View public key) so an unpacked build gets the same extension id — and
# therefore works with the Chrome-extension OAuth client above.
VITE_EXTENSION_KEY=
