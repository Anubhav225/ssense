# ═══════════════════════════════════════════════════════════════════════════
# apps/slm-server/.env.example
# Copy to `.env` in this directory and fill in real values before deploying.
# `docker-compose.yml` loads this file via `env_file: .env` for every profile
# (gpu / cpu / jetson). `scripts/run.sh` will auto-generate a starter `.env`
# with fresh secrets on first run, but it does NOT set every var below —
# review this file too, especially SSENSE_ALLOWED_ORIGINS and SSENSE_ENV.
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime mode ─────────────────────────────────────────────────────────────
# "production" enforces that SSENSE_API_KEYS/SSENSE_HMAC_SECRET are set to
# real, non-leaked values (security.py refuses to boot otherwise). Leave as
# "development" only for local/dev work.
SSENSE_ENV=production

# ── Authentication (required in production) ─────────────────────────────────
# Comma-separated pre-shared keys the extension sends as X-Ssense-API-Key.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SSENSE_API_KEYS=

# Optional subset of the keys above that get priority treatment. Safe to
# leave empty.
SSENSE_ENTERPRISE_API_KEYS=

# HMAC-SHA256 signing secret shared with the extension (signs
# X-Ssense-Signature over "<METHOD>:<path>:<timestamp>:<nonce>").
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SSENSE_HMAC_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI CORS middleware.
# The Chrome extension's background service worker is not subject to the
# same-origin CORS check the browser applies to page scripts, so this is
# defense-in-depth rather than the primary access control (that's the API
# key + HMAC signature above) - but don't leave it as "*" in production.
# Set it to the extension's own origin, e.g.:
#   SSENSE_ALLOWED_ORIGINS=chrome-extension://<your-extension-id>
SSENSE_ALLOWED_ORIGINS=*

# ── Compute profile ───────────────────────────────────────────────────────
# Must match the docker-compose profile you're running (gpu/cpu/jetson) -
# each Dockerfile.* already bakes the matching value in as a default, so you
# normally do NOT need to set this yourself; only override for local/manual
# (non-Docker) runs.
# SSENSE_COMPUTE_PROFILE=gpu

# ── Capacity / backpressure ──────────────────────────────────────────────
# Hard cap on concurrently in-flight requests (audit + chat combined) before
# new requests get a 503 instead of queueing indefinitely. This is the top
# of the "10k+ concurrent users" story: it's concurrent HELD-OPEN CONNECTIONS
# that scale via Nginx + async I/O, not concurrent GPU-resident generations
# (engine.py's max_num_seqs governs those, and is far lower - see engine.py's
# per-profile _build_*_args()).
SSENSE_MAX_QUEUE_DEPTH=5000

# Redis backs the chat rate limiter (distributed + durable across restarts
# and multiple replicas). If unset, unreachable, or the `redis` package is
# missing, the server automatically falls back to a correct-but-per-process
# in-memory limiter (redis_limiter.py) - Redis is a hardening upgrade here,
# not a hard dependency. docker-compose.yml already points this at the
# bundled `redis` service by default; only override if you run Redis
# elsewhere.
# SSENSE_REDIS_URL=redis://ssense-redis:6379/0

# ── CPU profile only ───────────────────────────────────────────────────────
# Thread count for the vLLM CPU backend. Leave unset to let vLLM auto-detect
# physical cores via VLLM_CPU_OMP_THREADS_BIND=auto (engine.py sets this
# default for you); only set explicitly if you need to reserve cores for
# something else on the host.
# SSENSE_CPU_THREADS=

# ── Global Tunnel / Public Domain ──────────────────────────────────────────
# Public HTTPS URL of this server when accessed through a Cloudflare Tunnel,
# reverse proxy, or public domain (e.g., https://<slug>.trycloudflare.com).
# Returned by /v1/auth/ping and used for client handshake and CORS hints.
SSENSE_PUBLIC_URL=

# ── Dynamic Handshake & User Registration ──────────────────────────────────
# Allow remote extension clients / laptops to self-register via POST /v1/auth/register
SSENSE_ALLOW_REGISTRATION=true

# Optional invite code required during handshake registration (leave blank to allow all lab users)
SSENSE_INVITE_CODE=

# Secret token for administrative access to GET /v1/admin/users
SSENSE_ADMIN_TOKEN=

# ── Domain / TLS (Optional for direct Nginx) ───────────────────────────────
# When hosting directly via Nginx on a purchased domain:
# Point domain DNS A/AAAA record at host, put certs at nginx/certs/ssense.crt + key.


# ── Google sign-in (required for the public release) ─────────────────────────
# Comma-separated OAuth client IDs the extension signs in with (the same values
# as VITE_GOOGLE_CLIENT_ID / VITE_GOOGLE_WEB_CLIENT_ID in the extension build).
# The server rejects Google tokens whose audience isn't in this list.
SSENSE_GOOGLE_CLIENT_IDS=

# true (default) = /v1/auth/register (unverified e-mail) is refused; users must
# sign in with Google. Set to false ONLY on a private lab server.
SSENSE_REQUIRE_GOOGLE_AUTH=true

# Development only — skips the audience check. NEVER enable in production.
# SSENSE_GOOGLE_SKIP_AUD_CHECK=false
