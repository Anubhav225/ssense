# ═══════════════════════════════════════════════════════════════════════════
# SOTA SLM SERVER DOCKERFILE (GPU / vLLM 0.27.1 / DGX Optimized)
# ═══════════════════════════════════════════════════════════════════════════

# 1. Use the official vLLM Base Image (Contains CUDA, PyTorch, Flash-Attn)
FROM vllm/vllm-openai:v0.27.1

# 2. Environment Variables for SOTA GPU Stability & Memory Control
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    VLLM_WORKER_MULTIPROCESS_METHOD=spawn \
    RAY_DISABLE_MEMORY_MONITOR=1 \
    HF_HOME=/app/.cache/huggingface \
    MODELS_DIR=/app/models \
    SSENSE_COMPUTE_PROFILE=gpu

WORKDIR /app

# 3. Install lightweight system dependencies
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gosu \
    && rm -rf /var/lib/apt/lists/*

# 4. Install Application Dependencies (PyTorch & vLLM are already in the base)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copy the microservice source code
COPY . /app

# 6. Create the non-root runtime user, but do NOT switch to it here with
# USER. GPU device access and CUDA driver libs are group/world-readable via
# the container runtime's device passthrough, not root-owned, so dropping
# privileges doesn't affect GPU access — but docker-compose.yml bind-mounts
# host directories into /app/models and /app/.cache/huggingface, and those
# are owned by whatever host user ran `docker compose up`, not by `ssense`.
# Switching to `ssense` here (via a bare `USER ssense`) would make every
# write into those mounts fail with PermissionError the moment a volume is
# actually attached — see docker-entrypoint.sh, which runs first AS ROOT,
# fixes ownership of just those two directories, then drops to `ssense` via
# gosu before exec'ing uvicorn. That's why USER ssense is deliberately
# absent below.
RUN groupadd -r ssense && useradd -r -g ssense -d /app -s /sbin/nologin ssense \
    && mkdir -p /app/.cache/huggingface /app/models /app/data \
    && chown -R ssense:ssense /app
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
ENTRYPOINT ["docker-entrypoint.sh"]

# 7. Expose API Port (Aligned with Nginx Gateway)
EXPOSE 8000

# 8. Strict Healthcheck (Start-period is 90s to allow the 15GB model to load into VRAM)
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 9. SOTA LAUNCH COMMAND: MUST use 1 worker for vLLM PagedAttention to function
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]